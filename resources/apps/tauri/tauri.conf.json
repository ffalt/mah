{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mah",
  "version": "2.1.1",
  "identifier": "io.github.ffalt.mah",
  "build": {
    "removeUnusedCommands": true,
    "beforeDevCommand": "cd ../../ && npm run start:development:apps",
    "devUrl": "http://0.0.0.0:4200",
    "beforeBuildCommand": "cd ../../ && npm run build:apps",
    "frontendDist": "../../../dist/"
  },
  "app": {
    "windows": [
      {
        "title": "Mah",
        "width": 1024,
        "height": 800,
        "maximized": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "ffalt",
    "category": "Game",
    "shortDescription": "A Mahjong Solitaire game with customizable layouts, tile sets, and difficulty modes",
    "longDescription": "Mah - Mahjong Solitaire is a relaxing single-player puzzle game where you clear a board by matching pairs of identical, free tiles. Choose from many layouts, customize your game with tile sets and light or dark variants, and play in three difficulty modes",
    "homepage": "https://github.com/ffalt/mah",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "appimage": {
        "files": {
          "/usr/share/metainfo/mah.appdata.xml": "assets/mah.appdata.xml"
        }
      },
      "deb": {
        "files": {
          "/usr/share/metainfo/mah.appdata.xml": "assets/mah.appdata.xml"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/metainfo/mah.appdata.xml": "assets/mah.appdata.xml"
        }
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
